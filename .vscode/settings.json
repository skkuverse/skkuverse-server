{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "building.module.ts": "building.*, *.json",
    "map.module.ts": "map.*, *.json",
    "miniapps.module.ts": "miniapps.*, *.json",
    "ui.module.ts": "ui.*, *.json",
    "*.module.ts": "${capture}.schema.ts, ${capture}.wire.ts",
    "*.service.ts": "${capture}.rules.ts, ${capture}.mapper.ts, ${capture}.types.ts",
    "*.repository.ts": "${capture}.query.ts, ${capture}.document.ts",
    "*.ts": "${capture}.spec.ts"
  }
}
