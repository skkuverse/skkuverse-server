{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "building.module.ts": "building.*, *.json",
    "building-place.module.ts": "building-place.*, *.json",
    "bus.module.ts": "bus.*, *.json",
    "bus-eta.module.ts": "bus-eta.*, *.json",
    "bus-realtime.module.ts": "bus-realtime.*, *.json",
    "bus-live.module.ts": "bus-live.*, *.json",
    "map.module.ts": "map.*, *.json",
    "miniapps.module.ts": "miniapps.*, *.json",
    "notices.module.ts": "notices.*, *.json",
    "ui.module.ts": "ui.*, *.json",
    "ui-transit.module.ts": "ui-transit.*, *.json",
    "subway.module.ts": "subway.*, *.json",
    "meals.module.ts": "meals.*, *.json",
    "*.module.ts": "${capture}.schema.ts, ${capture}.wire.ts",
    "*.service.ts": "${capture}.rules.ts, ${capture}.mapper.ts, ${capture}.types.ts",
    "*.repository.ts": "${capture}.query.ts, ${capture}.document.ts",
    "*.ts": "${capture}.spec.ts"
  }
}
