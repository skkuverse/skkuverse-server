{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cafeterias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "campus": {
            "type": "string",
            "enum": [
              "hssc",
              "nsc"
            ]
          },
          "name": {
            "type": "object",
            "properties": {
              "ko": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "required": [
              "ko",
              "en"
            ]
          },
          "building": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "skkuId": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "buildNo": {
                    "type": "string"
                  },
                  "displayNo": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": "object",
                    "properties": {
                      "ko": {
                        "type": "string"
                      },
                      "en": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ko",
                      "en"
                    ]
                  }
                },
                "required": [
                  "skkuId",
                  "buildNo",
                  "displayNo",
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "floor": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ko": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "ko",
                  "en"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "spaceCd": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Point"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "campus",
          "name",
          "building",
          "floor",
          "spaceCd",
          "location"
        ]
      }
    }
  },
  "required": [
    "cafeterias"
  ]
}
