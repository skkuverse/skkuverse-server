{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "board",
        "alight"
      ]
    },
    "timing": {
      "type": "string",
      "enum": [
        "scheduled",
        "estimated"
      ]
    },
    "stopId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "action",
    "timing"
  ]
}
