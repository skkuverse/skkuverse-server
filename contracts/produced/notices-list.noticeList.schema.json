{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "articleNo": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "department": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string"
          },
          "views": {
            "type": "number"
          },
          "sourceUrl": {
            "type": "string"
          },
          "hasContent": {
            "type": "boolean"
          },
          "hasAttachments": {
            "type": "boolean"
          },
          "isEdited": {
            "type": "boolean"
          },
          "summary": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "oneLiner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "action_required",
                      "event",
                      "informational"
                    ]
                  },
                  "startAt": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "time": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "date",
                          "time"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endAt": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "time": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "label": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "date",
                          "time",
                          "label"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "oneLiner",
                  "type",
                  "startAt",
                  "endAt"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "articleNo",
          "title",
          "category",
          "author",
          "department",
          "date",
          "views",
          "sourceUrl",
          "hasContent",
          "hasAttachments",
          "isEdited",
          "summary"
        ]
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "notices",
    "nextCursor",
    "hasMore"
  ]
}
