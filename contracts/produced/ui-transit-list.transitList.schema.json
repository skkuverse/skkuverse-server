{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "groupId": {
        "type": "string"
      },
      "card": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "themeColor": {
            "type": "string"
          },
          "iconType": {
            "type": "string"
          },
          "busTypeText": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "themeColor",
          "iconType",
          "busTypeText",
          "subtitle"
        ]
      },
      "action": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "/bus/realtime",
              "/bus/schedule"
            ]
          },
          "groupId": {
            "type": "string"
          }
        },
        "required": [
          "route",
          "groupId"
        ]
      }
    },
    "required": [
      "groupId",
      "card",
      "action"
    ]
  }
}
