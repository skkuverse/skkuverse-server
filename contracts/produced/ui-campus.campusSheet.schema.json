{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "minAppVersion": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "banner_carousel"
              },
              "id": {
                "type": "string"
              },
              "aspectRatio": {
                "type": "number"
              },
              "autoRotateSec": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "image"
                        },
                        "id": {
                          "type": "string"
                        },
                        "imageUrl": {
                          "type": "string"
                        },
                        "alt": {
                          "type": "string"
                        },
                        "actionType": {
                          "type": "string",
                          "enum": [
                            "miniapp",
                            "external",
                            "webview",
                            "route"
                          ]
                        },
                        "actionValue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id",
                        "imageUrl",
                        "alt"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "default"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "aspectRatio",
              "autoRotateSec",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "button_grid"
              },
              "id": {
                "type": "string"
              },
              "columns": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "emoji": {
                      "type": "string"
                    },
                    "actionType": {
                      "type": "string",
                      "enum": [
                        "miniapp",
                        "external",
                        "webview",
                        "route"
                      ]
                    },
                    "actionValue": {
                      "type": "string"
                    },
                    "webviewTitle": {
                      "type": "string"
                    },
                    "webviewColor": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "emoji",
                    "actionType",
                    "actionValue"
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "columns",
              "items"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "minAppVersion",
    "sections"
  ]
}
