{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "overview": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lead": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "cites": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "text",
                    "cites"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "cites": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "text",
                  "cites"
                ]
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "n": {
                    "type": "number"
                  },
                  "sourceId": {
                    "type": "string"
                  },
                  "articleNo": {
                    "type": "number"
                  },
                  "title": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "contentMissing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "n",
                  "sourceId",
                  "articleNo",
                  "title",
                  "date",
                  "contentMissing"
                ]
              }
            },
            "lang": {
              "type": "string",
              "enum": [
                "ko",
                "en"
              ]
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "lead",
            "points",
            "sources",
            "lang",
            "generatedAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "overview"
  ]
}
