{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "type": "string"
    },
    "buses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stationIndex": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "carNumber": {
            "type": "string"
          },
          "estimatedTime": {
            "type": "number"
          },
          "latitude": {
            "type": "string"
          },
          "longitude": {
            "type": "string"
          }
        },
        "required": [
          "stationIndex",
          "carNumber",
          "estimatedTime"
        ]
      }
    },
    "stationEtas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stationIndex": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "eta": {
            "type": "string"
          },
          "arrivals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minutes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stopsAway": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "running",
                    "arriving",
                    "waiting",
                    "ended",
                    "noInfo",
                    "unknown"
                  ]
                },
                "isLastBus": {
                  "type": "boolean"
                },
                "carNumber": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "crowding": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "relaxed",
                        "normal",
                        "crowded"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passengerCount": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "minutes",
                "stopsAway",
                "state",
                "isLastBus",
                "carNumber",
                "crowding",
                "passengerCount",
                "message"
              ]
            }
          }
        },
        "required": [
          "stationIndex",
          "eta",
          "arrivals"
        ]
      }
    }
  },
  "required": [
    "groupId",
    "buses",
    "stationEtas"
  ]
}
