{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "occupancy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "relaxed",
                "normal",
                "crowded"
              ]
            },
            "passengerCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "level",
            "passengerCount"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "seatsLeft": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "isLowFloor": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "occupancy",
    "seatsLeft",
    "isLowFloor"
  ]
}
