{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "articleNo": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "department": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": "string"
    },
    "views": {
      "type": "number"
    },
    "contentMarkdown": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "referer": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      }
    },
    "sourceUrl": {
      "type": "string"
    },
    "lastModified": {
      "type": [
        "string",
        "null"
      ]
    },
    "crawledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "editInfo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "detectedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "oldHash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "newHash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "oldTitle": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "newTitle": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "titleChanged": {
                    "type": "boolean"
                  },
                  "contentChanged": {
                    "type": "boolean"
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "history"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "oneLiner": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "action_required",
                "event",
                "informational"
              ]
            },
            "periods": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startDate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "startTime": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "endDate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "endTime": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kind": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "openEnded": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            },
            "locations": {
              "type": "array",
              "items": {}
            },
            "details": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "action": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "host": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "impact": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "text",
            "oneLiner",
            "type",
            "periods",
            "locations",
            "details",
            "model",
            "generatedAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "sourceId",
    "articleNo",
    "title",
    "category",
    "author",
    "department",
    "date",
    "views",
    "contentMarkdown",
    "attachments",
    "sourceUrl",
    "lastModified",
    "crawledAt",
    "editInfo",
    "summary"
  ]
}
