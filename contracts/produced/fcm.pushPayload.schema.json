{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notice"
        },
        "noticeId": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title_ko": {
          "type": "string"
        },
        "body_ko": {
          "type": "string"
        },
        "title_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "body_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "articleNo": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "noticeId",
        "topics",
        "title_ko",
        "body_ko",
        "title_en",
        "body_en"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "miniapp"
        },
        "miniAppId": {
          "type": "string"
        },
        "notificationId": {
          "type": "string"
        },
        "title_ko": {
          "type": "string"
        },
        "body_ko": {
          "type": "string"
        },
        "title_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "body_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionType": {
          "type": "string",
          "enum": [
            "miniapp",
            "external",
            "webview",
            "route"
          ]
        },
        "actionValue": {
          "type": "string"
        },
        "chipId": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "miniAppId",
        "notificationId",
        "title_ko",
        "body_ko",
        "title_en",
        "body_en"
      ]
    }
  ]
}
