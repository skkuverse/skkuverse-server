# Variables the server reads from its rendered .env in production.
#
# Names only; every one already appears in src/. Values live in Doppler
# backend/prd_server, which inherits the keys shared with the crawler from
# backend/prd. scripts/render_env.py renders exactly this set on deploy and
# fails if Doppler holds one name more or less.
# __tests__/nest/config/env-manifest.test.ts keeps this list honest.

# Shared with the crawler (backend/prd)
MONGO_URL
MONGO_DB_NAME_BUS_CAMPUS
INTERNAL_DISPATCH_TOKEN
SEOUL_BUS_SERVICE_KEY
API_HSSC_NEW_PROD

# Server only (backend/prd_server)
MONGO_BUILDING_DB_NAME
MONGO_NOTICES_DB_NAME
MONGO_EVENTMAP_DB_NAME
MONGO_MINIAPPS_DB_NAME
MONGO_MEALS_DB_NAME
MONGO_CONTENT_DB_NAME
NAVER_MAP_STYLE_ID
NOTICES_SERVICE_START_DATE
FCM_FUNCTION_URL
FCM_API_KEY
AI_API_URL
FIREBASE_SERVICE_ACCOUNT
SENTRY_DSN
# Production only, never in backend/dev_server: a laptop running the pollers
# must not keep the production check green.
HEALTHCHECKS_POLLER_PING_URL
APP_IOS_MIN_VERSION
APP_IOS_UPDATE_URL
APP_ANDROID_MIN_VERSION
APP_ANDROID_UPDATE_URL

# Shuttle arrival estimates (backend/dev_server, backend/prd_server). The NAVER
# values are the crawler's NCP application, piped from its config.
NAVER_API_KEY_ID
NAVER_API_KEY
TMAP_APP_KEY

# Public holidays from the KASI special-day calendar on data.go.kr
# (backend/dev_server, backend/prd_server).
DATA_GO_KR_SERVICE_KEY

# Seoul real-time subway positions and station arrivals on data.seoul.go.kr
# (backend/dev_server, backend/prd_server).
SEOUL_SUBWAY_API_KEY
