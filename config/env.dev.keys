# Variables the server reads from its rendered .env on a laptop.
#
# Names only; every one already appears in src/. Values live in Doppler
# backend/dev_server, which inherits the keys shared with the crawler from
# backend/dev. `npm run env:pull` renders exactly this set.
# __tests__/nest/config/env-manifest.test.ts keeps this list honest.

# Shared with the crawler (backend/dev)
MONGO_URL
MONGO_DB_NAME_BUS_CAMPUS
SEOUL_BUS_SERVICE_KEY
API_HSSC_NEW_PROD
API_HSSC_NEW_DEV

# Server only (backend/dev_server)
INTERNAL_DISPATCH_TOKEN
MONGO_BUILDING_DB_NAME
MONGO_NOTICES_DB_NAME
MONGO_EVENTMAP_DB_NAME
MONGO_MINIAPPS_DB_NAME
MONGO_MEALS_DB_NAME
MONGO_CONTENT_DB_NAME
NAVER_MAP_STYLE_ID
NOTICES_SERVICE_START_DATE
FCM_FUNCTION_URL
FCM_API_KEY
AI_API_URL
MINIAPP_PUSH_TOKEN
# /internal/subway/accuracy's own internal token (subway.accuracy scope).
SUBWAY_ACCURACY_TOKEN

# Shuttle arrival estimates (backend/dev_server, backend/prd_server). The NAVER
# values are the crawler's NCP application, piped from its config.
NAVER_API_KEY_ID
NAVER_API_KEY
TMAP_APP_KEY

# Seoul real-time subway positions and station arrivals on data.seoul.go.kr
# (backend/dev_server, backend/prd_server).
SEOUL_SUBWAY_API_KEY

# (A collector detail is left out of the public history.)
SHUTTLE_TOKEN

# 7800's seat poller (src/bus/realtime/gbis/), Gyeonggi bus positions on
# data.go.kr (backend/dev_server, backend/prd_server).
DATA_GO_KR_SERVICE_KEY

# The overlay perimeter's opaque settings, base64url JSON its entry validates (ADR 0023, D4),
# required in overlay mode (backend/dev_server for verify:serve, backend/prd_server).
PERIMETER_SETTINGS
# The overlay's push quotas, a settings section of its own (base64url JSON its entry validates), so the
# image a failed deploy rolls back to, which reads only PERIMETER_SETTINGS, still boots; required in overlay mode.
PERIMETER_SETTINGS_QUOTAS
