{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.js",
    "__tests__/**/*.test.{js,ts}"
  ],
  "project": ["**/*.{js,ts}"],
  "ignoreDependencies": ["pino-pretty"],
  "ignoreBinaries": ["python3"],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off"
  }
}
