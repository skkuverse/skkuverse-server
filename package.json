{
  "name": "skkuverse-server",
  "version": "3.5.1-260531",
  "private": true,
  "description": "",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34",
      "runtimeDownload": false
    }
  },
  "allowScripts": {
    "mongodb-memory-server": true
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "prestart": "npm run build",
    "dev": "npm run build && NODE_ENV=development PERIMETER_MODE=local-dev HOST=127.0.0.1 npm run dev:watch",
    "dev:prod-api": "npm run build && NODE_ENV=development PERIMETER_MODE=local-dev HOST=127.0.0.1 USE_PROD_API=true npm run dev:watch",
    "dev:watch": "concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --watch dist dist/src/main.js\" \"nodemon --quiet --on-change-only --watch src --ext json --exec 'node scripts/copy-build-assets.js'\"",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/copy-build-assets.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "lint": "eslint . && npm run lint:md",
    "lint:md": "markdownlint-cli2",
    "knip": "knip",
    "depcheck": "depcheck --ignores='pino-pretty,node-cron,nodemon,@types/node,@types/jest,@types/express,@types/supertest,@typescript-eslint/eslint-plugin,@typescript-eslint/parser'",
    "verify:serve": "node scripts/verify-serve.js up",
    "verify:serve:down": "node scripts/verify-serve.js down",
    "eventmap": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/eventmap-window.js",
    "eventmap:import": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/import-eventmap-places.js",
    "eventmap:revive-dev": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/eventmap-revive-dev.js",
    "campus:shapes": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/import-campus-shapes.js",
    "schedule": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/set-campus-schedule.js",
    "data": "npm run build --silent && NODE_OPTIONS=--dns-result-order=ipv4first node scripts/data.js",
    "contracts:export": "node scripts/export-contracts.js",
    "app-gate:check": "node scripts/app-gate-check.js",
    "env:pull": "python3 scripts/render_env.py --keys config/env.dev.keys --out .env --local -p backend -c dev_server"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "12.3.2",
    "@sentry/nestjs": "11.1.0",
    "axios": "1.20.0",
    "date-holidays": "3.37.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "firebase-admin": "13.10.0",
    "helmet": "8.2.0",
    "moment": "2.31.0",
    "moment-timezone": "0.6.2",
    "mongodb": "7.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.24",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "concurrently": "9.2.5",
    "depcheck": "1.4.7",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "knip": "6.14.2",
    "markdownlint-cli2": "0.24.0",
    "mongodb-memory-server": "11.3.0",
    "node-cron": "4.2.1",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3"
  }
}
